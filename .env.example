# MongoDB (Prisma datasource) — local replica set from docker-compose
DATABASE_URL="mongodb://localhost:27017/tycoma?replicaSet=rs0&directConnection=true"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth — JWT signing secret (httpOnly cookie)
# Local dev: any string ≥ 16 chars. The "change-me-..." placeholder below is
# for local convenience only — the placeholder is rejected by `parseEnv` at
# boot in production (`NODE_ENV === "production"`).
# Production bar (enforced by `src/shared/env.ts`): length ≥ 32, no documented
# placeholder strings, no leading/trailing whitespace. Generate with
# `openssl rand -base64 48` and inject via your secret manager.
AUTH_SECRET="change-me-to-a-long-random-string"

# Public site / admin
APP_URL="http://localhost:3000"

# S3-compatible storage (LocalStack in development)
S3_ENDPOINT="http://localhost:4566"
S3_REGION="us-east-1"
S3_BUCKET="tycoma-media"
S3_ACCESS_KEY_ID="test"
S3_SECRET_ACCESS_KEY="test"
S3_FORCE_PATH_STYLE="true"
S3_PUBLIC_BASE_URL="http://localhost:4566/tycoma-media"

# Phase C: contact published in /.well-known/security.txt (RFC 9116).
# Used by security researchers to report vulnerabilities.
SECURITY_CONTACT="admin@example.test"
