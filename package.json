{
  "name": "tycoma",
  "version": "0.1.0",
  "private": true,
  "description": "Tyny Content Manager (Tycoma) — single-tenant CMS with hexagonal modules, ready for a future split into services.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/modules/**/*.test.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "@prisma/client": "7.9.1",
    "ioredis": "^5.4.1",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "prisma": "7.9.1",
    "typescript": "^5.7.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/bcryptjs": "^2.4.6",
    "eslint": "^9.17.0",
    "eslint-config-next": "16.3.0"
  }
}
