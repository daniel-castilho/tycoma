{
  "name": "tycoma",
  "version": "0.1.0",
  "private": true,
  "description": "Tyny Content Manager (Tycoma) — single-tenant CMS with hexagonal modules, ready for a future split into services.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./scripts/test-register.mjs --experimental-strip-types --test --test-reporter=spec \"src/**/*.test.ts\"",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "6.19.3",
    "ioredis": "^5.4.1",
    "jose": "^6.2.13",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "16.4.2",
    "prisma": "6.19.3",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "deepmerge-ts": "8.0.1"
  }
}
