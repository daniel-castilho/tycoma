generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  email          String   @unique
  name           String
  passwordHash   String
  avatarMediaId  String?  @db.ObjectId
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Post {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  slug            String    @unique
  body            String
  status          String
  publishedAt     DateTime?
  scheduledAt     DateTime?
  featuredImageId String?   @db.ObjectId
  categoryIds     String[]  @db.ObjectId
  tagIds          String[]  @db.ObjectId
  metaTitle       String?
  metaDescription String?
  ogImageId       String?   @db.ObjectId
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Page {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  slug            String    @unique
  body            String
  status          String
  parentId        String?   @db.ObjectId
  publishedAt     DateTime?
  scheduledAt     DateTime?
  featuredImageId String?   @db.ObjectId
  metaTitle       String?
  metaDescription String?
  ogImageId       String?   @db.ObjectId
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Category {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String  @unique
  description String?
  parentId    String? @db.ObjectId
}

model Tag {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String  @unique
  description String?
}

model ContentType {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String   @unique
  description String?
  fields      Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ContentEntry {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  contentTypeId String   @db.ObjectId
  slug          String
  title         String
  status        String
  fields        Json
  publishedAt   DateTime?
  scheduledAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([contentTypeId, slug])
}

model MediaAsset {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  filename  String
  storageKey String  @unique
  url       String
  mimeType  String
  size      Int
  alt       String?
  caption   String?
  createdAt DateTime @default(now())
}

model Setting {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Menu {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  name String
  slug String @unique
}

model MenuItem {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  menuId   String  @db.ObjectId
  parentId String? @db.ObjectId
  label    String
  type     String
  refId    String?
  url      String?
  sortOrder Int
}

model AuditEvent {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  actorId    String?  @db.ObjectId
  eventType  String
  entityType String
  entityId   String?
  details    String?
  createdAt  DateTime @default(now())
}
